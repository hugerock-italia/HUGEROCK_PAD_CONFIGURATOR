{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(npm:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cd:*)",
      "Bash(dir:*)",
      "Bash(gh:*)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.claude/settings.local.json)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(.claude/settings.local.json)"
    ],
    "defaultMode": "default"
  }
}
